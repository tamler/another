{
  "description": "Another coordination hooks (toanother.one): messages and file holds between coding agents",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'@WRAPPER@' session-start --client codex",
            "timeout": 10,
            "statusMessage": "Another: registering this session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'@WRAPPER@' prompt --client codex",
            "timeout": 5,
            "statusMessage": "Another: checking for new messages"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'@WRAPPER@' session-end --client codex",
            "timeout": 3,
            "statusMessage": "Another: closing this session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'@WRAPPER@' post-tool --client codex",
            "timeout": 5,
            "statusMessage": "Another: delivering messages mid-task"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'@WRAPPER@' pre-edit --client codex",
            "timeout": 5,
            "statusMessage": "Another: checking file holds before an edit"
          }
        ]
      }
    ]
  }
}
